android_app {
    name: "HelixWallpapers",
    manifest: "AndroidManifest.xml",
    resource_dirs: ["res"],
    srcs: ["src/**/*.java"],
    sdk_version: "current",
    certificate: "platform",
    privileged: false,
    product_specific: true,
    optimize: {
        enabled: false,
    },
    aaptflags: [
        "--auto-add-overlay",
    ],
}
